#include "version.h"
#define IDI_CAPTURECLEAN 101
IDI_CAPTURECLEAN ICON "../assets/CaptureClean.ico"
1 24 "CaptureClean.manifest"

1 VERSIONINFO
FILEVERSION CC_VERSION_RC
PRODUCTVERSION CC_VERSION_RC
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CaptureClean Project\0"
      VALUE "FileDescription", "CaptureClean - captura local y privada\0"
      VALUE "FileVersion", CC_VERSION_A "\0"
      VALUE "InternalName", "CaptureClean\0"
      VALUE "LegalCopyright", "Copyright 2026 CaptureClean contributors\0"
      VALUE "OriginalFilename", "CaptureClean.exe\0"
      VALUE "ProductName", "CaptureClean\0"
      VALUE "ProductVersion", CC_VERSION_A "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
