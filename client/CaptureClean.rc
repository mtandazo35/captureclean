    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CaptureClean Project\0"
      VALUE "FileDescription", "CaptureClean - captura local y privada\0"
      VALUE "FileVersion", "2.10.1\0"
      VALUE "InternalName", "CaptureClean\0"
