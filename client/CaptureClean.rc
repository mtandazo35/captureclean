      VALUE "OriginalFilename", "CaptureClean.exe\0"
      VALUE "ProductName", "CaptureClean\0"
      VALUE "ProductVersion", "2.10.1\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
